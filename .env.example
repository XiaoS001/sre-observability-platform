# 复制本文件为 .env 后按需修改；.env 本身已被 .gitignore 排除，永不提交。
# 所有配置项缺省都有安全默认值，不配也能启动。

# --- 应用 ---
RMB03_HOST=127.0.0.1
RMB03_PORT=5000
RMB03_LOG_LEVEL=INFO

# --- 数据库 ---
# 默认 sqlite:///data/rmb03.db；生产可换 PostgreSQL 等
# RMB03_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/rmb03
# RMB03_DATA_DIR=

# --- 会话与鉴权（生产必改）---
# RMB03_SECRET_KEY=请替换为随机长字符串
RMB03_PASSWORD_SALT=请替换为随机长字符串

# --- 调度器 ---
RMB03_SCHEDULER_ENABLED=false
RMB03_SCHEDULER_TICK_SECONDS=10

# --- 告警通知 ---
RMB03_ALERT_COOLDOWN_SECONDS=300
# 可指向钉钉/飞书机器人或自建 URL；留空则只落库不外发
# RMB03_ALERT_WEBHOOK_URL=
# RMB03_ALERT_EMAIL_ENABLED=false
# RMB03_ALERT_EMAIL_TO=

# --- 三支柱 ---
# 留空则不启用（平台仍可正常启动）
# RMB03_LOKI_URL=http://127.0.0.1:3100
# RMB03_OTLP_ENDPOINT=http://127.0.0.1:4318

# --- AI 根因分析 ---
# 🔴 key 只从环境变量读，绝不写进代码。留空则自动退回规则路径。
DEEPSEEK_API_KEY=
RMB03_AI_ENABLED=true
# RMB03_AI_MODEL=deepseek-chat
# RMB03_AI_BASE_URL=https://api.deepseek.com